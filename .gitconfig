[core]
  quotepath = false  # 日本語文字化け対策
[init]
  defaultBranch = main
[status]
  showUntrackedFiles = all   # add 前に未追跡ファイルを全部見る
[commit]
  verbose = true             # commit 時にエディタへ diff 表示
[diff]
  algorithm = histogram      # 読みやすい diff
  colorMoved = default       # 移動した行を別色にする
  renames = copies
[push]
  default = current          # 現ブランチと同名で push
  followTags = true
[pull]
  rebase = true              # merge commit の乱立防止
[fetch]
  prune = true               # 消えたリモートブランチを掃除
[rebase]
  autoStash = true
[merge]
  conflictStyle = diff3      # 共通祖先も表示
[alias]
  st = status -sb
  ap = add -p
  ds = diff --staged
  lg = log --graph --oneline --decorate
  amend = commit --amend --no-edit